---
import { getCategories, formatStars, allRepos, categoryColor } from '../lib/repos';
import { href } from '../lib/url';
import Search from '../components/Search.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A curated collection of open-source repositories' } = Astro.props;

const categories = getCategories();
const navItems = Array.from(categories.values()).map((cat) => {
  const path = href(`/${cat.slug}/`);
  return {
    name: cat.name,
    path,
    count: cat.repos.length,
    dot: categoryColor(cat.name).header,
    current: Astro.url.pathname.startsWith(path),
  };
});
const currentCategory = navItems.find((item) => item.current);
const totalStars = allRepos.reduce((sum, r) => sum + r.stars, 0);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Awesome Stars</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-slate-900 text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between py-4">
          <a href={href('/')} class="flex items-center gap-3 hover:opacity-80 transition-opacity">
            <span class="text-2xl">⭐</span>
            <div>
              <div class="text-xl font-bold tracking-tight">Awesome Stars</div>
              <div class="text-slate-400 text-xs">
                {allRepos.length} repos · {formatStars(totalStars)} total stars
              </div>
            </div>
          </a>
          <Search />
        </div>

        <!-- Category nav: wraps on desktop, collapses into a disclosure on phones -->
        <nav aria-label="Categories" class="pb-3">
          <ul class="hidden sm:flex flex-wrap gap-1.5 lg:grid lg:grid-cols-4 lg:gap-x-2 lg:gap-y-1">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.path}
                  aria-current={item.current ? 'page' : undefined}
                  class:list={[
                    'inline-flex items-center gap-2 text-xs px-3 py-1.5 rounded-full whitespace-nowrap transition-colors',
                    item.current
                      ? 'bg-white text-slate-900 font-medium'
                      : 'text-slate-300 hover:text-white hover:bg-slate-700',
                  ]}
                >
                  <span class:list={['w-2 h-2 rounded-full shrink-0', item.dot]} aria-hidden="true"></span>
                  {item.name}
                </a>
              </li>
            ))}
          </ul>

          <details class="sm:hidden group">
            <summary class="flex items-center justify-between cursor-pointer list-none text-sm px-3 py-2 rounded-lg bg-slate-800 text-slate-200 [&::-webkit-details-marker]:hidden">
              <span>{currentCategory ? currentCategory.name : 'Categories'}</span>
              <span class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <ul class="grid grid-cols-2 gap-1 mt-2">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.path}
                    aria-current={item.current ? 'page' : undefined}
                    class:list={[
                      'flex items-center gap-2 text-xs px-3 py-2 rounded-lg transition-colors',
                      item.current ? 'bg-white text-slate-900 font-medium' : 'text-slate-300 hover:bg-slate-700',
                    ]}
                  >
                    <span class:list={['w-2 h-2 rounded-full shrink-0', item.dot]} aria-hidden="true"></span>
                    <span class="truncate">{item.name}</span>
                    <span class="ml-auto text-slate-500">{item.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center text-slate-500 text-sm">
        <p>
          {allRepos.length} curated repositories across {categories.size} categories ·
          Built with <a href="https://astro.build" class="text-slate-700 hover:underline">Astro</a>
        </p>
      </div>
    </footer>
  </body>
</html>
